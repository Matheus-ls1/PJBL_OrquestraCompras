PORT=3000
NODE_ENV=development
# URLs privadas chamadas somente pelo BFF.
IDENTITY_SERVICE_URL=http://localhost:3001
BUDGET_SERVICE_URL=http://localhost:3002
MONITORING_SERVICE_URL=http://localhost:7071
# Em produção, chave da Azure Function mantida somente no ambiente do BFF.
AZURE_FUNCTION_KEY=
# Tempo máximo de cada chamada a uma dependência, em milissegundos.
HTTP_TIMEOUT_MS=5000
# Origens separadas por vírgula. Não use * em produção.
CORS_ALLOWED_ORIGINS=http://localhost:5173
