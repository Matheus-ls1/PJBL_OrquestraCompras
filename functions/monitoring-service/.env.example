# Variáveis locais previstas para a Function App.
# Copie este arquivo para local.settings.json apenas para desenvolvimento local.
# Não versione local.settings.json nem adicione chaves de Function.
AzureWebJobsStorage=UseDevelopmentStorage=true
FUNCTIONS_WORKER_RUNTIME=node
ORCAMENTOS_EVENTOS_QUEUE_NAME=orcamentos-eventos-teste
MONGODB_MONITORING_URI=mongodb+srv://<usuario>:<senha>@<cluster>/db_monitoring?retryWrites=true&w=majority
MONGODB_MONITORING_DATABASE=db_monitoring_test
JWT_SECRET=mesmo-segredo-configurado-no-identity-service
# Opcional: nunca expor no frontend. Sem chave, a demonstração usa IA mock determinística.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
MONITORING_COLLECTION_SCHEDULE=0 */15 * * * *
MONITORING_COLLECTION_BATCH_SIZE=20
MONITORING_COLLECTION_ENABLED=false
MONITORING_COLLECTION_CONCURRENCY=2
MONITORING_CATALOG_TIMEOUT_MS=5000
    
