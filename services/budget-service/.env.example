PORT="3002"
NODE_ENV="development"
# Microsoft Entra via DefaultAzureCredential: Azure CLI local e Managed Identity na Azure.
# Não configure AZURE_SQL_USER, AZURE_SQL_PASSWORD ou tokens.
AZURE_SQL_SERVER="dbbudget.database.windows.net"
AZURE_SQL_PORT="1433"
AZURE_SQL_DATABASE="db_budget"
AZURE_SQL_AUTHENTICATION="azure-active-directory-default"
# Opcional: client ID de uma user-assigned Managed Identity na Azure.
AZURE_CLIENT_ID=
AZURE_SQL_ENCRYPT="true"
AZURE_SQL_TRUST_SERVER_CERTIFICATE="false"
AZURE_SQL_POOL_MAX="10"
# Deve ser o mesmo segredo HMAC do Identity Service no mesmo ambiente.
# Configure somente no .env local ou em variável segura da plataforma.
JWT_SECRET=

# Transactional Outbox Publisher. Não há publicação automática no npm run dev.
# A fila deve existir previamente; o publisher não cria recursos na Azure.
AZURE_STORAGE_QUEUE_NAME="orcamentos-eventos"
# Produção: URL da conta com DefaultAzureCredential / Managed Identity.
AZURE_STORAGE_ACCOUNT_URL=
# Desenvolvimento/Azurite: connection string explícita de ambiente controlado.
AZURE_STORAGE_CONNECTION_STRING=
OUTBOX_BATCH_SIZE="20"
OUTBOX_TIMEOUT_MS="10000"
OUTBOX_RETRY_MAX_TRIES="3"
# A versão inicial requer uma única instância do publisher.
OUTBOX_PUBLISHER_SINGLE_INSTANCE="true"
# Modo controlado: nunca use ID de orçamento/evento histórico compartilhado.
OUTBOX_TEST_EVENT_ID=
